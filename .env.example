# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Channel username for subscription check (with @)
CHANNEL_USER=@your_channel

# Free uses before subscription is required
FREE_USES_BEFORE_SUB=15

# Real-ESRGAN AI upscale (optional)
REAL_ESRGAN_BIN=
REAL_ESRGAN_MODELS=
ENABLE_REAL_AI=1

# Admin IDs (comma-separated)
ADMIN_IDS=123456789
ADMIN_ID=123456789

# Database path
DB_PATH=bot.db

# Downloads directory
DOWNLOAD_DIR=downloads

# Cleanup settings
CLEANUP_MAX_AGE_SECONDS=86400
CLEANUP_INTERVAL_SECONDS=3600

# Broadcast rate (messages per second)
BROADCAST_RATE=25

# Max file size in bytes (20MB)
MAX_FILE_SIZE=20971520
